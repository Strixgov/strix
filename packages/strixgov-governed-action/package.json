{
  "name": "@strixgov/governed-action",
  "version": "0.1.1",
  "description": "Wrap one consequential mutation — a REST call, a GitHub merge, any async operation — in a governed action that produces an independently verifiable signed receipt.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./capabilities": {
      "import": "./dist/capabilities.js",
      "types": "./dist/capabilities.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "node --test test/*.mjs",
    "prepublishOnly": "npm run build && npm test",
    "demo": "node bin/demo.mjs demo --self-check"
  },
  "keywords": [
    "strix",
    "governance",
    "ai-agents",
    "audit",
    "verifiable",
    "rest",
    "github"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Strixgov/strix",
    "directory": "packages/strixgov-governed-action"
  },
  "dependencies": {
    "@strixgov/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "governed-action": "bin/demo.mjs"
  }
}
