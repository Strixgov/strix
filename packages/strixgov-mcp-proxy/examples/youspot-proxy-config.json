{
  "serverId": "youspot",
  "upstream": {
    "command": "npx",
    "args": [
      "-y",
      "@youspot/mcp"
    ]
  },
  "capabilities": [
    {
      "id": "mcp.youspot.get_graph_object",
      "name": "get_graph_object",
      "risk": "LOW",
      "mode": "READ",
      "description": "Read one object from the YouSpot graph."
    },
    {
      "id": "mcp.youspot.list_graph_objects",
      "name": "list_graph_objects",
      "risk": "LOW",
      "mode": "READ",
      "description": "List objects from the YouSpot graph."
    },
    {
      "id": "mcp.youspot.search_graph_objects",
      "name": "search_graph_objects",
      "risk": "LOW",
      "mode": "READ",
      "description": "Search the YouSpot graph."
    },
    {
      "id": "mcp.youspot.get_gmail_message",
      "name": "get_gmail_message",
      "risk": "LOW",
      "mode": "READ",
      "description": "Read one Gmail message."
    },
    {
      "id": "mcp.youspot.search_gmail_messages",
      "name": "search_gmail_messages",
      "risk": "LOW",
      "mode": "READ",
      "description": "Search connected Gmail mailboxes."
    },
    {
      "id": "mcp.youspot.list_gmail_labels",
      "name": "list_gmail_labels",
      "risk": "LOW",
      "mode": "READ",
      "description": "List Gmail labels."
    },
    {
      "id": "mcp.youspot.get_calendar_events",
      "name": "get_calendar_events",
      "risk": "LOW",
      "mode": "READ",
      "description": "Read calendar events."
    },
    {
      "id": "mcp.youspot.list_google_calendars",
      "name": "list_google_calendars",
      "risk": "LOW",
      "mode": "READ",
      "description": "List Google calendars."
    },
    {
      "id": "mcp.youspot.list_slack_channels",
      "name": "list_slack_channels",
      "risk": "LOW",
      "mode": "READ",
      "description": "List Slack channels known to YouSpot."
    },
    {
      "id": "mcp.youspot.get_slack_thread",
      "name": "get_slack_thread",
      "risk": "LOW",
      "mode": "READ",
      "description": "Read a saved Slack thread."
    },
    {
      "id": "mcp.youspot.search_slack_messages",
      "name": "search_slack_messages",
      "risk": "LOW",
      "mode": "READ",
      "description": "Search saved Slack messages."
    },
    {
      "id": "mcp.youspot.list_integrations",
      "name": "list_integrations",
      "risk": "LOW",
      "mode": "READ",
      "description": "List connected integrations."
    },
    {
      "id": "mcp.youspot.add_slack_reaction",
      "name": "add_slack_reaction",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Add a reaction to a Slack message."
    },
    {
      "id": "mcp.youspot.archive_gmail_message",
      "name": "archive_gmail_message",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Archive a Gmail message."
    },
    {
      "id": "mcp.youspot.connect_graph_objects",
      "name": "connect_graph_objects",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Create a directed edge between graph objects."
    },
    {
      "id": "mcp.youspot.create_gmail_draft",
      "name": "create_gmail_draft",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Create a Gmail draft."
    },
    {
      "id": "mcp.youspot.create_graph_object",
      "name": "create_graph_object",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Create a YouSpot graph object."
    },
    {
      "id": "mcp.youspot.disconnect_graph_objects",
      "name": "disconnect_graph_objects",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Remove a graph-object edge."
    },
    {
      "id": "mcp.youspot.set_follow_up",
      "name": "set_follow_up",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Create a dated follow-up fact."
    },
    {
      "id": "mcp.youspot.set_notification_emails",
      "name": "set_notification_emails",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Change YouSpot notification-email settings."
    },
    {
      "id": "mcp.youspot.update_graph_object",
      "name": "update_graph_object",
      "risk": "MEDIUM",
      "mode": "WRITE",
      "description": "Update fields on a graph object."
    },
    {
      "id": "mcp.youspot.create_calendar_event",
      "name": "create_calendar_event",
      "risk": "HIGH",
      "mode": "WRITE",
      "description": "Create or queue a calendar event."
    },
    {
      "id": "mcp.youspot.send_email",
      "name": "send_email",
      "risk": "HIGH",
      "mode": "WRITE",
      "description": "Send email to the signed-in user's own address."
    },
    {
      "id": "mcp.youspot.send_slack_message",
      "name": "send_slack_message",
      "risk": "HIGH",
      "mode": "WRITE",
      "description": "Post a Slack message or DM."
    },
    {
      "id": "mcp.youspot.send_text_to_user",
      "name": "send_text_to_user",
      "risk": "HIGH",
      "mode": "WRITE",
      "description": "Send an iMessage/SMS to the user's verified phone."
    },
    {
      "id": "mcp.youspot.delete_graph_object",
      "name": "delete_graph_object",
      "risk": "CRITICAL",
      "mode": "WRITE",
      "description": "Delete one graph object."
    },
    {
      "id": "mcp.youspot.delete_graph_objects",
      "name": "delete_graph_objects",
      "risk": "CRITICAL",
      "mode": "WRITE",
      "description": "Delete all graph objects of one type."
    },
    {
      "id": "mcp.youspot.disconnect_integration",
      "name": "disconnect_integration",
      "risk": "CRITICAL",
      "mode": "WRITE",
      "description": "Disconnect an integration; may delete synced records."
    }
  ],
  "policy": {
    "rules": {
      "mcp.youspot.get_graph_object": "ALLOW",
      "mcp.youspot.list_graph_objects": "ALLOW",
      "mcp.youspot.search_graph_objects": "ALLOW",
      "mcp.youspot.get_gmail_message": "ALLOW",
      "mcp.youspot.search_gmail_messages": "ALLOW",
      "mcp.youspot.list_gmail_labels": "ALLOW",
      "mcp.youspot.get_calendar_events": "ALLOW",
      "mcp.youspot.list_google_calendars": "ALLOW",
      "mcp.youspot.list_slack_channels": "ALLOW",
      "mcp.youspot.get_slack_thread": "ALLOW",
      "mcp.youspot.search_slack_messages": "ALLOW",
      "mcp.youspot.list_integrations": "ALLOW"
    },
    "riskOverrides": {
      "LOW": "APPROVAL_REQUIRED",
      "MEDIUM": "APPROVAL_REQUIRED",
      "HIGH": "APPROVAL_REQUIRED",
      "CRITICAL": "DENY"
    },
    "default": "DENY"
  },
  "approval": {
    "enabled": false
  },
  "storagePath": "~/.strix-mcp-proxy/youspot",
  "keyPath": "~/.strix-mcp-proxy/youspot/keys"
}
