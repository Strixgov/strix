{
  "name": "@strixgov/swarm-adapter",
  "version": "0.2.0",
  "description": "Bring your swarm. Strix governs it. A framework-neutral bridge that turns a real multi-agent run (Claude Agent SDK / CrewAI / LangGraph / OpenAI Swarm) into signed delegations + governed tool calls + independently-verifiable proof.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./claude-agent-sdk": {
      "import": "./dist/bindings/claude-agent-sdk.js",
      "types": "./dist/bindings/claude-agent-sdk.d.ts"
    },
    "./langgraph": {
      "import": "./dist/bindings/langgraph.js",
      "types": "./dist/bindings/langgraph.d.ts"
    }
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "demo": "node examples/governed-swarm-demo.mjs --dry-run",
    "test": "node scripts/preflight.mjs && node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "strix",
    "ai-agents",
    "agent-swarm",
    "governance",
    "delegation",
    "claude-agent-sdk",
    "crewai",
    "langgraph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Strixgov/strix",
    "directory": "packages/strixgov-swarm-adapter"
  },
  "dependencies": {
    "@strixgov/sdk": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
